{
  "name": "veda-sanjeevani-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-check.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/manrope": "^5.2.5",
    "@fontsource/tiro-devanagari-hindi": "^5.2.5",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "^5.90.0",
    "dompurify": "^3.2.7",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  }
