# StudioFlow / Nexora environment. Copy to .env (never commit secrets).
#
# Two runtimes consume variables from this file:
#   * the Node API server (`server.ts`, bundled to `dist/server.cjs`) and the
#     Vercel serverless functions in `api/` read the unprefixed names;
#   * the browser bundle reads only the `VITE_SUPABASE_*` names, which are
#     inlined into the JavaScript at build time.
# A privileged key must never be placed in a `VITE_*` variable: everything in
# the `VITE_` namespace is sent to every visitor.

# ---------------------------------------------------------------------------
# Web + API server (server.ts loads this file via dotenv)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=
# Optional. Text model for /api/ai-recommendations and Veda content; the server
# falls back to its built-in default when empty.
GEMINI_TEXT_MODEL=
# Optional dev-only helpers (ignored when NODE_ENV=production):
# open a template directly at the site root, and switch off Vite HMR (set to
# "true" in sandboxes where websockets are unavailable).
PREVIEW_TEMPLATE=
STUDIOFLOW_PREVIEW_TEMPLATE=
DISABLE_HMR=

# ---------------------------------------------------------------------------
# Supabase — trusted server side only
# ---------------------------------------------------------------------------
# Set these as deployment secrets (Vercel environment variables or
# `supabase secrets set`), never in this file for a hosted environment.
# SUPABASE_URL is the project the server talks to. It must be an HTTPS URL
# without credentials; the server validates it at start-up and prints only the
# project host.
SUPABASE_URL=
# The privileged key. It is required by the demo-request route, the
# `submit-landing-lead` Edge Function and the manager-only lead API. Never
# expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy alias for the privileged key.
SUPABASE_SECRET_KEY=
# Optional public key used by the server when it only has to verify a signed
# session (used by the manager-only lead API when no privileged key is set).
SUPABASE_ANON_KEY=
# Publishable key used to verify Supabase access tokens on the AI routes
# (`server/supabaseAuth.ts`). When empty, the server falls back to
# SUPABASE_ANON_KEY, then to the public default already shipped in
# src/lib/supabase.ts, so sign-in is enforced without extra configuration.
# A secret/service-role key here is detected and refused.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Proxy / rate limiting (server)
# ---------------------------------------------------------------------------
# The AI routes are rate limited per caller address. Behind a proxy the real
# client address arrives in x-forwarded-for, so Express `trust proxy` must be
# enabled or every caller shares the proxy's budget:
#   TRUST_PROXY=1                 one proxy hop (Vercel sets this automatically)
#   TRUST_PROXY=loopback,10.0.0.0/8   explicit trusted ranges
# Leave empty when the Node server is directly exposed, so a caller cannot
# spoof x-forwarded-for and reset its own budget.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# NEXORA SALONOS landing page — public browser configuration
# ---------------------------------------------------------------------------
# Only the publishable key may be set here. Leave the values empty to use the
# project defaults that ship in src/lib/supabase.ts.
# Project URL of the landing project (no trailing slash).
VITE_SUPABASE_URL=
# Publishable browser key (sb_publishable_... / legacy anon JWT).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias, still honoured when VITE_SUPABASE_PUBLISHABLE_KEY is empty.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Demo requests (public form -> Edge Function -> private lead register)
# ---------------------------------------------------------------------------
# Optional CRM sink. When it is set, a stored lead is forwarded after the lead
# is already durable in the register; a failure never removes the lead and is
# recorded as the CRM delivery state. It must be an HTTPS URL without
# embedded credentials.
NEXORA_CRM_LEAD_ENDPOINT=
# Optional bearer token for the CRM sink. It is sent from the server only.
NEXORA_CRM_LEAD_TOKEN=
# Salt for the shared rate-limit bucket key of the Edge Function. Set a
# different value per environment to keep the buckets separate. The salted
# hash is stored; the address itself never is.
LANDING_LEAD_RATE_LIMIT_SALT=
# Version of the published privacy notice that is stamped on every lead.
PRIVACY_NOTICE_VERSION=2026-11
# Cloudflare Turnstile secret for the `submit-landing-lead` Edge Function.
# WARNING: when this is empty the function SKIPS bot verification entirely
# (fail-open). Set it as an Edge secret in every public environment.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Online payments (Razorpay) for studioflow-payments + nexora-mobile-qr
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Customer welcome WhatsApp (studioflow-welcome-whatsapp)
# ---------------------------------------------------------------------------
NEXORA_WA_ACCESS_TOKEN=
NEXORA_WA_PHONE_NUMBER_ID=
NEXORA_WA_WELCOME_TEMPLATE=
NEXORA_WA_TEMPLATE_LANGUAGE=en_US
NEXORA_WA_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Owner campaign WhatsApp (studioflow-campaign-whatsapp)
# ---------------------------------------------------------------------------
STUDIOFLOW_MARKETING_WHATSAPP_TOKEN=
STUDIOFLOW_MARKETING_WHATSAPP_PHONE_ID=
STUDIOFLOW_MARKETING_WHATSAPP_TEMPLATE=
STUDIOFLOW_MARKETING_WHATSAPP_LANGUAGE=en_US
STUDIOFLOW_MARKETING_GRAPH_VERSION=
STUDIOFLOW_MARKETING_OWNER_ID=

# ---------------------------------------------------------------------------
# Salon map geocoding (studioflow-map-locations; defaults to Nominatim)
# ---------------------------------------------------------------------------
STUDIOFLOW_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# ---------------------------------------------------------------------------
# Email Service (Resend) for automated booking confirmations and reminders
# ---------------------------------------------------------------------------
# Booking email requires a signed-in owner/customer; SUPABASE_URL +
# SUPABASE_ANON_KEY are used to validate the JWT and read the booking through
# RLS. Without RESEND_API_KEY the endpoints return 503 instead of simulated
# success. Set these as deployment/Edge secrets, never in the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StudioFlow <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Canonical HTTPS origin for /sitemap.xml (Node server and Vercel function)
# ---------------------------------------------------------------------------
# Required in deployment; never derive canonical URLs from request Host headers.
SITE_URL=
