# StudioFlow / Nexora environment. Copy to .env (never commit secrets).
# Web + API server (server.ts loads this file via dotenv).
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Supabase edge functions (set with `supabase secrets set`, not in this file, for hosted use).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Online payments (Razorpay) for studioflow-payments + nexora-mobile-qr.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Customer welcome WhatsApp (studioflow-welcome-whatsapp).
NEXORA_WA_ACCESS_TOKEN=
NEXORA_WA_PHONE_NUMBER_ID=
NEXORA_WA_WELCOME_TEMPLATE=
NEXORA_WA_TEMPLATE_LANGUAGE=en_US
NEXORA_WA_GRAPH_VERSION=v21.0

# Owner campaign WhatsApp (studioflow-campaign-whatsapp).
STUDIOFLOW_MARKETING_WHATSAPP_TOKEN=
STUDIOFLOW_MARKETING_WHATSAPP_PHONE_ID=
STUDIOFLOW_MARKETING_WHATSAPP_TEMPLATE=
STUDIOFLOW_MARKETING_WHATSAPP_LANGUAGE=en_US
STUDIOFLOW_MARKETING_GRAPH_VERSION=
STUDIOFLOW_MARKETING_OWNER_ID=

# Salon map geocoding (studioflow-map-locations; defaults to Nominatim).
STUDIOFLOW_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Email Service (Resend) for automated booking confirmations and appointment reminders.
# Used by server.ts and Supabase Edge Function studioflow-booking-emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StudioFlow <onboarding@resend.dev>

# Canonical HTTPS origin for /sitemap.xml (Node server and Vercel function).
# Required in deployment; never derive canonical URLs from request Host headers.
SITE_URL=
