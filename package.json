{
  "name": "studioflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:edge": "tsc -p tsconfig.edge.json --noEmit",
    "test": "npm run lint && npm run lint:edge && npm run build && node scripts/run-all-verifications.mjs",
    "test:address": "node scripts/verify-address-stability.mjs",
    "test:wiring": "node scripts/verify-website-wiring.mjs",
    "test:debug": "node scripts/verify-debug-boundary.mjs",
    "test:live": "node scripts/verify-supabase.mjs",
    "test:template12": "node scripts/verify-template12-ui.mjs && node scripts/verify-template12-social-media-loyalty.mjs && node scripts/verify-template12-promotions-share-reels.mjs && node scripts/verify-template12-migration.mjs",
    "test:multibranch": "node scripts/verify-multibranch-migration.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^14.7.1",
    "idb": "^8.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "react-test-renderer": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
